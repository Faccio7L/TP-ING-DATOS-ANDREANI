CREATE VIEW VW_CumplimientoPorCliente
    --MUESTRA LA CANTIDAD DE ENTREGAS POR CLIENTE Y LAS ENTREGADAS EN FECHA. 
    AS
    SELECT C.NOMBRECLIENTE, COUNT(E.IdPedido) AS PEDIDOS_TOTALES,(
        SELECT COUNT((E2.IDPEDIDO))
        FROM CLIENTE C2
        INNER JOIN PEDIDO P2 ON P2.IDCLIENTE = C2.IDCLIENTE
        INNER JOIN ENTREGA E2 ON E2.IdPedido = P2.IdPedido
        WHERE P2.FechaEntregaSolicitada >= E2.FechaEntregaReal AND C2.NOMBRECLIENTE = C.NOMBRECLIENTE
    ) AS ENTREGADO_EN_FECHA
    FROM CLIENTE C
    INNER JOIN PEDIDO P ON P.IdCliente = C.IDCLIENTE
    INNER JOIN ENTREGA E ON E.IdPedido = P.IdPedido
    GROUP BY C.NOMBRECLIENTE
    
    