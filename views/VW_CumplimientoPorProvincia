CREATE VIEW VW_CumplimientoPorProvincia
    --MUESTRA LA CANTIDAD DE ENTREGAS POR PROVINCIA Y LAS ENTREGADAS EN FECHA. 
    AS
    SELECT D.PROVINCIA, COUNT(E.IdPedido) AS PEDIDOS_TOTALES,(
        SELECT COUNT((E2.IDPEDIDO))
        FROM DESTINO D2
        INNER JOIN PEDIDO P2 ON P2.IdDestino = D2.IDDESTINO
        INNER JOIN ENTREGA E2 ON E2.IdPedido = P2.IdPedido
        WHERE P2.FechaEntregaSolicitada >= E2.FechaEntregaReal AND D.PROVINCIA = D2.PROVINCIA
    ) AS ENTREGADO_EN_FECHA
    FROM DESTINO D
    INNER JOIN PEDIDO P ON P.IdDestino = D.IDDESTINO
    INNER JOIN ENTREGA E ON E.IdPedido = P.IdPedido
    GROUP BY D.PROVINCIA
    ORDER BY ENTREGADO_EN_FECHA
    