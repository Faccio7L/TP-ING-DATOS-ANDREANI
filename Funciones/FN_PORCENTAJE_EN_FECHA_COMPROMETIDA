
CREATE FUNCTION FN_PORCENTAJE_EN_FECHA_COMPROMETIDA(
    -- FUNCION PARA VER PORCENTAJE DE ENTREGAS EN FECHA COMPROMETIDA SIEMPRE Y CUANDO LA FECHA DE ENTREGA
    --SOLICITADA SE ENCUENTRE EN EL LAPSO PLANTEADO EN LOS PARAMETROS.
    @DESDE DATE,
    @HASTA DATE
)
    RETURNS DECIMAL(5,2)
    AS
    BEGIN
        DECLARE @PORCENTAJE DECIMAL(5,2)
        DECLARE @ENTREGADOS_EN_FECHA INT
        DECLARE @CANTIDAD_PEDIDOS INT

        SELECT @CANTIDAD_PEDIDOS = COUNT(P.IdPedido)
        FROM PEDIDO P
        WHERE P.FechaEntregaSolicitada > @DESDE AND P.FechaEntregaSolicitada < @HASTA AND P.EstadoPedido = 'ENTREGADO'

        
        SELECT @ENTREGADOS_EN_FECHA = COUNT(P.IdPedido)
        FROM PEDIDO P
        INNER JOIN ENTREGA E ON E.IdPedido = P.IdPedido
        WHERE P.FechaEntregaSolicitada > @DESDE AND P.FechaEntregaSolicitada < @HASTA AND P.EstadoPedido = 'ENTREGADO' AND E.FechaEntregaReal <= P.FechaEntregaSolicitada

        SET @PORCENTAJE = @ENTREGADOS_EN_FECHA *100 / @CANTIDAD_PEDIDOS
        RETURN ISNULL(@PORCENTAJE,0)
    END



