--CREAR PEDIDO, DESCONTAR STOCK DE LOTES, CREAR DETALLE PEDIDO Y VALIDACIONES!
CREATE PROCEDURE CARGAR_PEDIDO(
    @IDCLIENTE INT,
    @IDDESTINO INT,
    @FECHAENTREGASOLICITADA DATE,
    @TEMPERATURAPEDIDO DECIMAL(5,3)
)
AS
BEGIN
    BEGIN TRY
        DECLARE @EXISTE_CLIENTE INT
        DECLARE @EXISTE_DESTINO INT

        SELECT @EXISTE_CLIENTE = C.IDCLIENTE
        FROM CLIENTE C
        WHERE C.IDCLIENTE = @IDCLIENTE

        IF @EXISTE_CLIENTE IS NULL
        BEGIN
            PRINT('NO EXISTE EL CLIENTE.')
            RETURN 
        END
        
        SELECT @EXISTE_DESTINO = D.IDDESTINO
        FROM DESTINO D
        WHERE D.IDDESTINO = @IDDESTINO
        
        IF @EXISTE_DESTINO IS NULL
        BEGIN 
            PRINT('NO EXISTE EL DESTINO')
            RETURN
        END
        
        IF @FECHAENTREGASOLICITADA <= CAST(GETDATE() AS DATE)
        BEGIN
            PRINT('FECHA INVALIDA.')
            RETURN
        END

        BEGIN TRANSACTION

        INSERT PEDIDO(IdCliente, IdDestino, FechaEntregaSolicitada, TemperaturaPedido)
        VALUES(@IDCLIENTE, @IDDESTINO, @FECHAENTREGASOLICITADA, @TEMPERATURAPEDIDO)
        
        COMMIT TRANSACTION

    END TRY
    BEGIN CATCH 
        IF @@TRANCOUNT > 0
        ROLLBACK
        PRINT('HA OCURRIDO UN ERROR')
    END CATCH
    END
GO


CREATE PROCEDURE CARGAR_DETALLE_Y_PREPARAR(
    @IDPEDIDO INT,
    @IDPRODUCTO INT,
    @CANTIDAD INT
)
AS
BEGIN
    BEGIN TRY
        DECLARE @STOCK_TOTAL INT
        DECLARE @EXISTE_PEDIDO INT
        DECLARE @EXISTE_PRODUCTO INT
        DECLARE @CANTIDAD_PENDIENTE INT
        DECLARE @IDLOTE_ACTUAL INT
        DECLARE @STOCK_ESTE_LOTE INT

        SET @CANTIDAD_PENDIENTE = @CANTIDAD

        SELECT @EXISTE_PEDIDO = P.IdPedido 
        FROM PEDIDO P
        WHERE P.IdPedido = @IDPEDIDO

        IF @EXISTE_PEDIDO IS NULL 
        BEGIN
            PRINT('EL PEDIDO NO EXISTE')
            RETURN
        END

        SELECT @EXISTE_PRODUCTO = PR.IDPRODUCTO 
        FROM PRODUCTO PR
        WHERE PR.IDPRODUCTO = @IDPRODUCTO

        IF @EXISTE_PRODUCTO IS NULL
        BEGIN
            PRINT('NO EXISTE EL PRODUCTO')
            RETURN
        END

        SELECT @STOCK_TOTAL = SUM(L.STOCKLOTE) 
        FROM LOTE L
        WHERE L.IDPRODUCTO = @IDPRODUCTO AND L.FECHAVENCIMIENTO > GETDATE()
        
        IF @STOCK_TOTAL IS NULL 
        BEGIN
            SET @STOCK_TOTAL = 0
        END

        IF @STOCK_TOTAL < @CANTIDAD
        BEGIN
            PRINT('NO HAY STOCK SUFICIENTE')
            RETURN
        END

        BEGIN TRANSACTION

        INSERT DETALLEPEDIDO(IdPedido, IdProducto, CantidadSolicitada)
        VALUES (@IDPEDIDO, @IDPRODUCTO, @CANTIDAD)

        
        DECLARE CursorFEFO CURSOR FOR  --EL CURSOR PERMITE RECORRER LINEA POR LINEA.
        SELECT L.IDLOTE, L.STOCKLOTE 
        FROM LOTE L
        WHERE L.IDPRODUCTO = @IDPRODUCTO AND L.FECHAVENCIMIENTO > GETDATE() AND L.STOCKLOTE > 0
        ORDER BY L.FECHAVENCIMIENTO ASC

        OPEN CursorFEFO
        FETCH NEXT FROM CursorFEFO INTO @IDLOTE_ACTUAL, @STOCK_ESTE_LOTE

        WHILE @@FETCH_STATUS = 0 AND @CANTIDAD_PENDIENTE > 0 --SI FETCH STATUS ES 0 SIGNIFICA QUE TIENE LINEAS POR RECORRER.
        BEGIN
            IF @STOCK_ESTE_LOTE >= @CANTIDAD_PENDIENTE
            BEGIN
                UPDATE LOTE 
                SET STOCKLOTE = STOCKLOTE - @CANTIDAD_PENDIENTE 
                WHERE IDLOTE = @IDLOTE_ACTUAL
                
                INSERT PREPARACION (IdLote, IdProducto, IdPedido, CantidadPreparada)
                VALUES (@IDLOTE_ACTUAL, @IDPRODUCTO, @IDPEDIDO, @CANTIDAD_PENDIENTE)
                
                SET @CANTIDAD_PENDIENTE = 0 
            END
            ELSE
            BEGIN
                --CUANDO NO ALCANZA A CUBRIR EL PEDIDO TOTAL.
                UPDATE LOTE 
                SET STOCKLOTE = 0 
                WHERE IDLOTE = @IDLOTE_ACTUAL
                
                INSERT PREPARACION (IdLote, IdProducto, IdPedido, CantidadPreparada)
                VALUES (@IDLOTE_ACTUAL, @IDPRODUCTO, @IDPEDIDO, @STOCK_ESTE_LOTE)
                
                SET @CANTIDAD_PENDIENTE = @CANTIDAD_PENDIENTE - @STOCK_ESTE_LOTE
            END

            FETCH CursorFEFO INTO @IDLOTE_ACTUAL, @STOCK_ESTE_LOTE --CAMBIO DE LOTE.

        END

        CLOSE CursorFEFO
        DEALLOCATE CursorFEFO

        COMMIT TRANSACTION

    END TRY
    BEGIN CATCH
     PRINT('ERROR DURANTE EL PROCESAMIENTO FEFO')
            ROLLBACK
        
    END CATCH
END
GO
