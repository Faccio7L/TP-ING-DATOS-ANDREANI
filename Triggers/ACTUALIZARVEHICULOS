USE andreani
GO
CREATE TRIGGER TRG_DESPACHO_ACTUALIZAR_VEHICULO
ON DESPACHO
AFTER INSERT
AS
BEGIN
    DECLARE @IDVEHICULO INT
    SELECT @IDVEHICULO  = IDVEHICULO FROM inserted

    UPDATE VEHICULO
    SET Disponible = 0
    WHERE IdVehiculo = @IDVEHICULO
    PRINT('VEHICULO ASIGNADO COMO NO DISPONIBLE')
END